CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Leave empty for local use through the Express backend proxy.
# Set to the deployed FastAPI URL when hosting the static website on Vercel.
API_BASE_URL=
BACKEND_URL=http://127.0.0.1:8000
PORT=3000
